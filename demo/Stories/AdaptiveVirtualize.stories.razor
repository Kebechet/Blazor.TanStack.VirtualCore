@attribute [Stories("Components/AdaptiveVirtualize")]

<Stories TComponent="VirtualListPlayground">

    <Story Name="Ten thousand rows">
        <Description>
            Ten thousand items, of which only the visible window plus <code>Overscan</code> exists in
            the DOM at any moment. Scroll and watch the row numbers climb while the element count
            stays flat - that constant count is the whole point.
        </Description>
        <Template>
            <VirtualListPlayground TestId="uniform"
                                   Shape="VirtualListPlayground.ListShape.Uniform"
                                   ItemCount="10000"
                                   ScrollTargetIndex="5000"
                                   Options="_overscanOptions"
                                   Hint="The core claim: 10,000 items, but only the visible window plus Overscan exists in the DOM. Scroll and watch row numbers climb while the element count stays flat. The buttons drive the imperative API; the panel below shows GetSnapshot's live state." />
        </Template>
    </Story>

    <Story Name="Variable heights">
        <Description>
            Row bodies cycle through 1, 8, 25 and 3 words, so heights vary by roughly five times.
            Every row is measured individually and its size cached against its key. This is the case
            a single <code>ItemSize</code> - or a running average - cannot place correctly: short rows
            end up too far apart and tall ones overlap.
        </Description>
        <Template>
            <VirtualListPlayground TestId="variable"
                                   Shape="VirtualListPlayground.ListShape.Variable"
                                   ItemCount="5000"
                                   ScrollTargetIndex="2500"
                                   Options="_overscanOptions"
                                   Hint="Exact per-row measurement - the case a fixed ItemSize or a running average cannot place. Bodies cycle 1, 8, 25 and 3 words, yet every row deliberately shares one 70px estimate, so you can see measurement refine the layout without gaps or overlaps." />
        </Template>
    </Story>

    <Story Name="Expand and collapse">
        <Description>
            Clicking a group inserts three children in place. The group row's own height changes while
            its key stays the same, so its cached measurement is stale - which is what
            <code>InvalidateItemSize(key)</code> is for. Without it the group keeps its old height and
            the children render overlapping its bottom edge.
        </Description>
        <Template>
            <VirtualListPlayground TestId="expandable"
                                   Shape="VirtualListPlayground.ListShape.Expandable"
                                   ItemCount="500"
                                   ScrollTargetIndex="100"
                                   Options="_overscanOptions"
                                   Hint="InvalidateItemSize(key): click any group row to insert three children in place. The group's height changes while its key does not, so its cached measurement is evicted - every other row's measurement survives the item-set change untouched." />
        </Template>
    </Story>

    <Story Name="Horizontal">
        <Description>
            <code>IsHorizontal</code> lays the list out along the x axis. Sizes are then measured as
            widths, and the component translates on X while splitting the cross axis by height. Use it
            for a card rail or a timeline.
        </Description>
        <Template>
            <VirtualListPlayground TestId="horizontal"
                                   Shape="VirtualListPlayground.ListShape.Cards"
                                   ItemCount="4000"
                                   ScrollTargetIndex="1000"
                                   ViewportClass="viewport-horizontal"
                                   Options="_horizontalOptions"
                                   Hint="IsHorizontal lays the list out along the x axis - sizes are measured as widths and the list scrolls sideways, for a card rail or timeline. The viewport is deliberately wide and short so the horizontal axis is the one doing the work." />
        </Template>
    </Story>

    <Story Name="Lanes (masonry)">
        <Description>
            <code>Lanes</code> turns the list into a multi-column masonry grid. Items are distributed
            across lanes and each placement reports the <code>Lane</code> it landed in, which the
            component converts into the item's cross-axis position and width.
            <code>LaneAssignmentMode</code> chooses whether balancing uses estimates or measured
            sizes - <code>Measured</code> packs more evenly once measurement settles.
        </Description>
        <Template>
            <VirtualListPlayground TestId="lanes"
                                   Shape="VirtualListPlayground.ListShape.Cards"
                                   ItemCount="3000"
                                   ScrollTargetIndex="600"
                                   Options="_laneOptions"
                                   Hint="Lanes = 3 turns the list into a masonry grid: items are distributed across lanes and each placement carries the lane it landed in. LaneAssignmentMode.Measured balances by real size once measurement settles. Cards are deliberately uneven so the lanes stay ragged." />
        </Template>
    </Story>

    <Story Name="Gap and padding">
        <Description>
            <code>Gap</code> inserts space between consecutive items, and <code>PaddingStart</code> /
            <code>PaddingEnd</code> reserve space before the first and after the last. All three are
            part of the virtualizer's own geometry rather than CSS, so offsets and total size account
            for them - a CSS margin would not.
        </Description>
        <Template>
            <VirtualListPlayground TestId="spacing"
                                   Shape="VirtualListPlayground.ListShape.Cards"
                                   ItemCount="2000"
                                   ScrollTargetIndex="400"
                                   Options="_spacingOptions"
                                   Hint="Gap = 16 and PaddingStart/PaddingEnd = 40 are virtualizer geometry, not CSS - offsets and total size account for them, which a margin could not. Note the first item starts 40px down and every seam is exactly 16px." />
        </Template>
    </Story>

    <Story Name="Always-rendered indexes">
        <Description>
            Upstream's <code>rangeExtractor</code> is a JavaScript function called on every range
            computation, so marshalling it to .NET would cost an interop round-trip per scroll frame.
            It is modelled as <code>AlwaysRenderedIndexes</code>, which the interop layer compiles
            into a real extractor that unions those indices with the default range. Use it for a
            sticky header, a pinned selection, or a row being dragged.
        </Description>
        <Template>
            <VirtualListPlayground TestId="pinned"
                                   Shape="VirtualListPlayground.ListShape.Uniform"
                                   ItemCount="5000"
                                   ScrollTargetIndex="2000"
                                   Options="_pinnedOptions"
                                   Hint="AlwaysRenderedIndexes = [0, 1] keeps those rows in the DOM however far away you scroll - a sticky header, a pinned selection, a row being dragged. Jump to row 2000, then inspect the DOM: rows 0 and 1 are still there." />
        </Template>
    </Story>

    <Story Name="Follow on append">
        <Description>
            <code>FollowOnAppend</code> makes the viewport track items added to the end, and
            <code>AnchorTo</code> chooses which edge stays stable when content shifts. Together they
            are what a log tail or a chat transcript needs. Press <em>Append 10</em> while scrolled to
            the bottom.
        </Description>
        <Template>
            <VirtualListPlayground TestId="follow"
                                   Shape="VirtualListPlayground.ListShape.Uniform"
                                   ItemCount="300"
                                   ScrollTargetIndex="200"
                                   Options="_followOptions"
                                   Hint="FollowOnAppend + AnchorTo = End: the shape of a chat transcript or log tail. Scroll to the end, then press Append 10 - the viewport follows the new items instead of stranding you behind them." />
        </Template>
    </Story>

    <Story Name="Disabled">
        <Description>
            <code>IsEnabled = false</code> disables scroll observation and <strong>resets</strong>
            the virtualizer - upstream empties the rendered window and clears its measurement caches,
            so the items disappear. That is virtual-core's documented behaviour, not a freeze.
            Re-enabling re-observes, re-measures and brings the items back at the preserved scroll
            position. Useful while a panel is hidden, so an off-screen list stops paying for any
            scroll or measurement work at all.
        </Description>
        <Template>
            <VirtualListPlayground TestId="disabled"
                                   Shape="VirtualListPlayground.ListShape.Uniform"
                                   ItemCount="1000"
                                   ScrollTargetIndex="500"
                                   Options="_disabledOptions"
                                   Hint="IsEnabled = false disables scroll observation and RESETS the virtualizer - the items disappear because upstream empties the window and clears its caches (documented behaviour, not a freeze). Press Disable and the list empties; press Enable and it comes back at the same scroll position." />
        </Template>
    </Story>

    <Story Name="Right to left">
        <Description>
            <code>IsRtl</code> flips the axis offsets are measured along, for right-to-left locales.
            Pair it with <code>IsHorizontal</code> for a card rail that starts on the right.
        </Description>
        <Template>
            <VirtualListPlayground TestId="rtl"
                                   Shape="VirtualListPlayground.ListShape.Cards"
                                   ItemCount="2000"
                                   ScrollTargetIndex="500"
                                   ViewportClass="viewport-horizontal"
                                   Options="_rtlOptions"
                                   Hint="IsRtl flips the axis offsets are measured along, for right-to-left locales - combined here with IsHorizontal, so the card rail starts on the right and scrolls leftward." />
        </Template>
    </Story>

    <Story Name="Window scroller">
        <Description>
            <code>UseWindowScroller</code> virtualizes against the window rather than a scrollable
            ancestor, swapping in virtual-core's <code>observeWindowRect</code> /
            <code>observeWindowOffset</code> / <code>windowScroll</code> trio. Use it when the list
            scrolls with the whole document instead of inside its own box - note this story has no
            scroll container of its own.
        </Description>
        <Template>
            <VirtualListPlayground TestId="window"
                                   Shape="VirtualListPlayground.ListShape.Uniform"
                                   ItemCount="2000"
                                   ScrollTargetIndex="400"
                                   ViewportClass="viewport-window"
                                   Options="_windowOptions"
                                   Hint="UseWindowScroller virtualizes against the document instead of a scrollable ancestor - this story has no scroll container of its own, so scroll the page itself. For lists that flow with the whole page rather than sitting in a box." />
        </Template>
    </Story>

    <Story Name="Imperative API">
        <Description>
            The full method surface on one list: <code>ScrollToIndex</code>,
            <code>ScrollToOffset</code>, <code>ScrollToEnd</code>, <code>ScrollBy</code>,
            <code>ResizeItem</code> and <code>GetSnapshot</code>. The state panel shows what
            <code>GetSnapshot</code> reads back from the live virtualizer - scroll offset, total size,
            whether it is at the end, and the current rendered range.
        </Description>
        <Template>
            <VirtualListPlayground TestId="api"
                                   Shape="VirtualListPlayground.ListShape.Variable"
                                   ItemCount="20000"
                                   ScrollTargetIndex="12345"
                                   Options="_overscanOptions"
                                   Hint="Every button maps to one public method: ScrollToIndex / ScrollToOffset / ScrollToEnd / ScrollBy / ScrollToTop, ResizeItem (overrides a measured size without touching the DOM), and Read state = GetSnapshot, whose live values fill the panel below - over 20,000 mixed-height rows." />
        </Template>
    </Story>

</Stories>

@code {
    private readonly VirtualizeOptions _overscanOptions = new()
    {
        Overscan = 3,
    };

    private readonly VirtualizeOptions _horizontalOptions = new()
    {
        IsHorizontal = true,
        Overscan = 3,
        Gap = 8,
    };

    private readonly VirtualizeOptions _laneOptions = new()
    {
        Lanes = 3,
        LaneAssignmentMode = LaneAssignmentMode.Measured,
        Gap = 10,
        Overscan = 4,
    };

    private readonly VirtualizeOptions _spacingOptions = new()
    {
        Gap = 16,
        PaddingStart = 40,
        PaddingEnd = 40,
        Overscan = 3,
    };

    private readonly VirtualizeOptions _pinnedOptions = new()
    {
        AlwaysRenderedIndexes = [0, 1],
        Overscan = 2,
    };

    private readonly VirtualizeOptions _followOptions = new()
    {
        FollowOnAppend = FollowOnAppend.Instant,
        AnchorTo = ScrollAnchor.End,
        Overscan = 3,
    };

    private readonly VirtualizeOptions _disabledOptions = new()
    {
        // Starts enabled: with IsEnabled false from the first render virtual-core places nothing at
        // all, so there would be no list to watch freeze. The story's Disable button is the point.
        IsEnabled = true,
        Overscan = 3,
    };

    private readonly VirtualizeOptions _rtlOptions = new()
    {
        IsHorizontal = true,
        IsRtl = true,
        Gap = 8,
        Overscan = 3,
    };

    private readonly VirtualizeOptions _windowOptions = new()
    {
        UseWindowScroller = true,
        Overscan = 3,
    };
}
