@typeparam TItem
@inject IJSRuntime _jsRuntime
@inject ILogger<AdaptiveVirtualize<TItem>> _logger

@* Keys, placements and the stale-row filtering are resolved in _rowsToRender, which recomputes only
   when the window, the item set or the options change. Doing it here meant several string
   allocations per row on every render batch, and a scrolling list produces hundreds of those. *@
<div @ref="_rootElement" style="@_containerStyle">
    @foreach (var row in _rowsToRender)
    {
        @* data-key is how the JS side recognises a row it may move before this render catches up -
           see syncRenderedRows in adaptive-virtualize-interop.js. *@
        <div @key="row.Key"
             data-index="@row.Index"
             data-key="@row.Key"
             style="@row.Style">
            @ItemContent(row.Item)
        </div>
    }
</div>
